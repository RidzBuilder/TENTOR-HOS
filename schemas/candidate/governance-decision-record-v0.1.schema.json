{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"TENTOR HOS V.2 Candidate Governance Decision Record v0.1",
  "type":"object","additionalProperties":false,
  "required":["decision_id","decision_type","subject_ref","scope","authority_ref","decision","effective_revision","evidence_refs"],
  "properties":{
    "decision_id":{"type":"string","pattern":"^DEC-[A-Z0-9_-]+$"},
    "decision_type":{"enum":["APPROVE","REJECT","ACCEPT_FOR_SCOPE","REVOKE","DEPRECATE","WAIVE","REQUEST_RETEST"]},
    "subject_ref":{"type":"string","minLength":1},
    "scope":{"type":"string","minLength":1},
    "authority_ref":{"type":"string","minLength":1},
    "decision":{"enum":["GRANTED","DENIED","CONDITIONAL","DEFERRED"]},
    "effective_revision":{"type":"string","minLength":1},
    "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "conditions":{"type":"array","items":{"type":"string"}},
    "supersedes":{"type":["string","null"]},
    "reason":{"type":"string","minLength":1}
  }
}